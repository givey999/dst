{
  "name": "@dst/main",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "electron --inspect=5858 --no-sandbox node:tsx src/index.ts",
    "dev:simple": "electron .",
    "build": "tsc -p tsconfig.build.json",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "DST_E2E_GATE=1 vitest run -c vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@dst/shared": "workspace:*",
    "argon2": "^0.41.1",
    "discord.js": "^14.16.0",
    "eventemitter3": "^5.0.1",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^32.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
