{
  "name": "@dst/preload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.renameSync('dist/index.js','dist/index.cjs');try{fs.renameSync('dist/index.js.map','dist/index.cjs.map')}catch(e){}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint'"
  },
  "dependencies": {
    "@dst/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^32.0.0",
    "typescript": "^5.6.0"
  }
}
