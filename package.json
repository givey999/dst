{
  "name": "dst",
  "version": "0.1.0",
  "private": true,
  "description": "Encrypted infinite storage over Discord",
  "main": "packages/main/dist/index.js",
  "author": "givey999 <bogdan.moldovan@gmail.com>",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @dst/main dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "package:portable": "pnpm build && electron-builder --config electron-builder.yml --win portable"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "discord.js": "^14.16.0",
    "eventemitter3": "^5.0.1",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
